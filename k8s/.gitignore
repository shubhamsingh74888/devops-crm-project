cat > .gitignore << 'EOF'
# ── Secrets & credentials ──────────────────────
*.env
.env
.env.*
.env.local
.env.production
secret.yml
*secret*
*secrets*
*.pem
*.key
*.p12

# ── Docker ─────────────────────────────────────
.docker/

# ── OS files ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ───────────────────────────────────────
logs/
*.log

# ── Kubernetes local configs ───────────────────
kubeconfig
*.kubeconfig
EOF
